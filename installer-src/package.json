{
  "name": "midnightcord-installer",
  "productName": "Midnightcord Installer",
  "description": "A simple standalone program which automates the installation, removal and maintenance of Midnightcord.",
  "author": "Midnightcord",
  "version": "1.3.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "compile": "electron-forge package",
    "lint": "eslint --ext .svelte,.js src/",
    "dist": "npm run compile && electron-builder --win -p never",
    "dist:dir": "npm run compile && electron-builder --win --dir -c.compression=store"
  },
  "dependencies": {
    "@electron/remote": "^2.1.4",
    "source-map-support": "^0.5.16"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-svelte": "^3.24.1",
    "find-process": "https://github.com/BetterDiscord/find-process",
    "focus-visible": "^5.2.0",
    "phin": "^3.7.0",
    "rimraf": "^3.0.2",
    "semver": "^7.3.8",
    "svelte": "^5.57.3",
    "svelte-loader": "^3.2.4",
    "svelte-spa-router": "^5.1.1",
    "tree-kill": "^1.2.2",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^4.4.0"
  },
  "build": {
    "appId": "app.midnightcord.installer",
    "productName": "Midnightcord",
    "copyright": "Copyright © 2026 Midnightcord",
    "directories": {
      "output": "../release/installer"
    },
    "win": {
      "artifactName": "Midnightcord-Installer.${ext}",
      "icon": "assets/icon.ico",
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "mac": {
      "artifactName": "${productName}-Mac.${ext}",
      "icon": "assets/icon.icns",
      "category": "public.app-category.social-networking",
      "target": {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    },
    "linux": {
      "artifactName": "${productName}-Linux.${ext}",
      "category": "Utility",
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  },
  "main": ".webpack/main/index.cjs"
}
